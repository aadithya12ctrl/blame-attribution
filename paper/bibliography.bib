% ------------------------------------------- LLM-as-judge / rubric design
@misc{yu2026rubric,
  author    = {Yu, Dingyao and Zhang, Tong and Mou, Yutao and
               Zhang, Yunxiao and Ye, Wei and Zhang, Shikun},
  title     = {Mitigating Rubric Interference in {LLM} Judges via On-Policy
               Self-Distillation},
  year      = {2026},
  eprint    = {2608.14684},
  archivePrefix = {arXiv},
  primaryClass  = {cs.CL},
  note      = {Defines ``rubric interference'': the verdict on one rubric
               shifts depending on which other rubrics are co-present. Only
               about one third of samples receive fully consistent verdicts
               across rubric sets of varying composition; interference is
               probed by rubric expansion, subsetting, reordering and noise
               injection}
  % verified: arXiv:2608.14684 abstract page
}

